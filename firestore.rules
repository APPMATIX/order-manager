rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- HELPERS ----------
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // MANDATORY: Global Status Check
    // This helper ensures that any account marked as 'paused' is blocked from business logic.
    function isSuspended() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'paused';
    }

    function isAllowed() {
      return isAuthenticated() && !isSuspended();
    }

    function isAdmin() { 
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin')
      );
    }

    // ---------- RULES ----------

    match /users/{userId} {
      // Profile access - allow get for self even if paused to allow the UI to show suspension reason
      allow get: if isAuthenticated(); 
      allow list: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if (isAllowed() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin() && request.auth.uid != userId;

      // Purchase Bills
      match /purchase_bills/{billId} {
        allow read, write: if (isAllowed() && request.auth.uid == userId) || isAdmin();
      }

      // Orders - Enhanced participant permissions for B2B dual-write consistency
      match /orders/{orderId} {
        // Strict ownership for listing
        allow list: if (isAllowed() && request.auth.uid == userId) || isAdmin();
        
        // Read access for owners, admins, and participants
        allow get: if (isAllowed() && (request.auth.uid == userId || resource.data.clientId == request.auth.uid || resource.data.vendorId == request.auth.uid)) || isAdmin();
        
        // Create/Update/Delete access for participants
        allow create, update, delete: if isAdmin() || (isAllowed() && (
          (userId == request.auth.uid) ||
          (resource != null && (resource.data.clientId == request.auth.uid || resource.data.vendorId == request.auth.uid)) ||
          (request.resource != null && (request.resource.data.clientId == request.auth.uid || request.resource.data.vendorId == request.auth.uid))
        ));
      }

      // Products
      match /products/{productId} {
        allow read: if isAllowed();
        allow write: if (isAllowed() && request.auth.uid == userId) || isAdmin();
      }

      // Clients
      match /clients/{clientId} {
        allow read, write: if (isAllowed() && (request.auth.uid == userId || request.auth.uid == clientId)) || isAdmin();
      }
    }

    match /vendors/{vendorId} {
      allow read, list: if isAllowed();
      allow write: if (isAllowed() && request.auth.uid == vendorId) || isAdmin();
    }

    match /signup_tokens/{tokenId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if request.resource.data.status == 'used'
                    && resource.data.status == 'active'
                    && request.time < resource.data.expiresAt;
    }
  }
}