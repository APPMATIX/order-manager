rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- HELPERS ----------
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() { 
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin')
      );
    }

    // ---------- RULES ----------

    match /users/{userId} {
      allow get: if isAuthenticated(); 
      allow list: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin() && request.auth.uid != userId;

      // Purchase Bills
      match /purchase_bills/{billId} {
        allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      }

      // Orders - Enhanced participant permissions for B2B dual-write consistency
      match /orders/{orderId} {
        // Strict ownership for listing per requirement
        allow list: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
        
        // Read access for owners, admins, and participants
        allow get: if (isAuthenticated() && request.auth.uid == userId) || isAdmin() 
                   || (isAuthenticated() && (resource.data.clientId == request.auth.uid || resource.data.vendorId == request.auth.uid));
        
        // Create/Update/Delete access for owners, admins, and participants
        allow create, update, delete: if (isAuthenticated() && request.auth.uid == userId) || isAdmin()
                      || (isAuthenticated() && (
                          (resource != null && (resource.data.clientId == request.auth.uid || resource.data.vendorId == request.auth.uid)) ||
                          (request.resource != null && (request.resource.data.clientId == request.auth.uid || request.resource.data.vendorId == request.auth.uid))
                      ));
      }

      // Products
      match /products/{productId} {
        allow read: if isAuthenticated();
        allow write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      }

      // Clients
      match /clients/{clientId} {
        allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin() || request.auth.uid == clientId;
      }
    }

    match /vendors/{vendorId} {
      allow read, list: if isAuthenticated();
      allow write: if (isAuthenticated() && request.auth.uid == vendorId) || isAdmin();
    }

    match /signup_tokens/{tokenId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if request.resource.data.status == 'used'
                    && resource.data.status == 'active'
                    && request.time < resource.data.expiresAt;
    }
  }
}